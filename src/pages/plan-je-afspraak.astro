---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import site from '../data/site.json';
import { telHref } from '../lib/text';
---

<Base title="Plan je afspraak" description={`Plan online een afspraak bij ${site.name} in ${site.city}.`}>
  <PageHero eyebrow="Plan je afspraak" title="Plan je afspraak" lead="Kies hieronder een moment dat jou past." />

  <section class="book">
    <div class="wrap bgrid">
      <div>
        <p class="consent-note">
          Bij het boeken bevestig je dat je de <a href="/privacy/">privacyverklaring</a> en het toestemmingsformulier gelezen hebt.
          Na het boeken ontvang je per e-mail het toestemmingsformulier dat bij jouw behandeling hoort.
        </p>
        {site.calendlyUrl ? (
          <>
            <div class="calendly-inline-widget" data-url={`${site.calendlyUrl}?hide_gdpr_banner=1&primary_color=4a5a27`}></div>
            <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
          </>
        ) : (
          <div class="fallback">
            <h3>Online plannen is binnenkort mogelijk</h3>
            <p>Neem intussen gerust contact op, dan zoeken we samen een moment.</p>
            <div class="actions">
              <a class="btn magnetic" href={telHref(site.phone)}>Bel {site.phone}</a>
              <a class="btn ghost magnetic" href={`mailto:${site.email}`}>Mail mij</a>
            </div>
          </div>
        )}
      </div>
      <aside class="book-side">
        <div class="note fade"><h4>Liever eerst even praten?</h4><p>Bel <a href={telHref(site.phone)}>{site.phone}</a> of mail naar <a href={`mailto:${site.email}`}>{site.email}</a>.</p></div>
        <div class="note fade"><h4>Waar?</h4><p>{site.practice}<br />{site.street}, {site.postalCode} {site.city}</p></div>
        <div class="note fade"><h4>Annuleren</h4><p>{site.cancellationPolicy}</p></div>
        <div class="note fade"><h4>Betalen</h4><p>{site.paymentMethods}.</p></div>
      </aside>
    </div>
  </section>
</Base>
