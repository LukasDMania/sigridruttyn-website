---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import site from '../data/site.json';
import { telHref } from '../lib/text';

const page = await getEntry('pages', 'praktische-info');
if (!page) throw new Error('src/content/pages/praktische-info.md ontbreekt');
const { Content } = await render(page);
const treatments = (await getCollection('pages', (p) => p.data.isTreatment)).sort((a, b) => a.data.order - b.data.order);
const address = `${site.street}, ${site.postalCode} ${site.city}`;
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---

<Base title={page.data.title} description={page.data.subtitle}>
  <PageHero eyebrow="Praktische info" title={page.data.title} lead={page.data.subtitle} />

  <section class="pinfo">
    <div class="wrap pgrid">
      <nav class="toc fade" aria-label="Op deze pagina">
        <a href="#tarieven">Tarieven</a>
        <a href="#voorbereiding">Info voor lichaamswerk</a>
        <a href="#betalen">Betalen &amp; annuleren</a>
        <a href="#locatie">Locatie &amp; contact</a>
      </nav>
      <div class="pcontent">
        <section id="tarieven">
          <h2 class="split">Tarieven</h2>
          <div class="rates">
            {treatments.map((t) => (
              <a class="rate fade" href={`/${t.id}/`}>
                <span class="rate-t">{t.data.title}</span>
                <span class="rate-d">{t.data.durationLong}</span>
                <span class="rate-p">{t.data.price}</span>
              </a>
            ))}
          </div>
        </section>

        <section id="voorbereiding" class="prose"><Content /></section>

        <section id="betalen">
          <h2 class="split">Betalen &amp; annuleren</h2>
          <div class="two">
            <div class="note fade"><h4>Betaalwijze</h4><p>{site.paymentMethods}.</p></div>
            <div class="note fade"><h4>Annuleringsvoorwaarden</h4><p>{site.cancellationPolicy}</p></div>
          </div>
        </section>

        <section id="locatie">
          <h2 class="split">Locatie &amp; contact</h2>
          <div class="loc fade">
            <svg class="map" viewBox="0 0 400 240" aria-hidden="true">
              <path d="M0 150 C 80 130, 140 190, 220 150 S 340 90, 400 110" stroke="#c5cfaa" stroke-width="16" fill="none" stroke-linecap="round" />
              <path d="M120 0 V240 M280 0 V240 M0 70 H400 M0 200 H400" stroke="#fbf9f4" stroke-width="10" />
              <g class="pin"><path d="M200 60c-17 0-30 13-30 30 0 22 30 50 30 50s30-28 30-50c0-17-13-30-30-30z" fill="#4a5a27" /><circle cx="200" cy="90" r="10" fill="#fbf9f4" /></g>
            </svg>
            <div class="loc-txt">
              <h3>{site.practice}</h3>
              <p>{site.street}<br />{site.postalCode} {site.city}</p>
              <p><a href={telHref(site.phone)}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
              <a class="btn ghost magnetic" href={maps} target="_blank" rel="noopener">Route plannen ↗</a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
  <Cta />
</Base>
