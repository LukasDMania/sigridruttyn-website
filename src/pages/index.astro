---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import TreatmentRows from '../components/TreatmentRows.astro';
import Breath from '../components/Breath.astro';
import Reviews from '../components/Reviews.astro';
import Cta from '../components/Cta.astro';
import site from '../data/site.json';
import { inline } from '../lib/text';

const treatments = (await getCollection('pages', (p) => p.data.isTreatment)).sort((a, b) => a.data.order - b.data.order);
const about = await getEntry('pages', 'wie-ben-ik');
const arrow = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5"/></svg>';
---

<Base loader>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1 class="split" set:html={inline(site.homeTitle)} />
        <div class="actions fade">
          <a class="btn magnetic" href="/plan-je-afspraak/">Plan je afspraak <Fragment set:html={arrow} /></a>
          <a class="btn ghost magnetic" href="/wie-ben-ik/">Wie ben ik?</a>
        </div>
        <div class="scroll-cue fade"><i></i>Scroll</div>
      </div>
      <div class="hero-media">
        <Photo src={about?.data.image} alt={about?.data.imageAlt} label="Portret Sigrid" />
        <div class="badge" aria-hidden="true">
          <svg viewBox="0 0 120 120"><defs><path id="c" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs><text><textPath href="#c">Lichaam · Adem · Rust · Evenwicht ·</textPath></text></svg>
          <svg class="leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 22V6M12 14c-3-1-5-3-5.5-6 3 .3 5 2.5 5.5 6zM12 10c2.5-.8 4-2.7 4.5-5.5-2.6.4-4.1 2.3-4.5 5.5z" /></svg>
        </div>
      </div>
    </div>
  </section>

  <section class="statement">
    <div class="wrap">
      <p class="eyebrow">Mijn aanpak</p>
      <p class="lit-text">{site.homeStatement}</p>
      <div class="sig">{site.name}</div>
    </div>
  </section>

  <section class="treat" id="behandelingen">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="eyebrow">Behandelingen</p><h2 class="split">Waarvoor kan je bij mij terecht?</h2></div>
        <p class="fade">Elke sessie wordt afgestemd op wat jij op dat moment nodig hebt, met respect voor je grenzen en je eigen tempo.</p>
      </div>
      <TreatmentRows items={treatments} />
    </div>
  </section>

  <Breath />

  <section class="about">
    <div class="wrap about-grid">
      <Photo label="Sigrid in de praktijk" tone={2} />
      <div>
        <p class="eyebrow">Wie ben ik?</p>
        <h2 class="split">Het menselijk lichaam heeft mij altijd enorm geboeid.</h2>
        <div class="body fade">
          <p>Tijdens mijn werk als kinesitherapeut ontdekte ik dat het behandelen van enkel de lichamelijke klacht niet altijd voldoende is. Soms blijft een klacht terugkomen, of voelt het alsof er meer aan de hand is.</p>
          <p>Dat bracht mij ertoe om verder te kijken: <em>wat probeert het lichaam ons te vertellen?</em></p>
        </div>
        <div class="pillars fade">{about?.data.facts.slice(0, 4).map((f) => <span>{f.value}</span>)}</div>
        <div class="actions fade"><a class="btn ghost magnetic" href="/wie-ben-ik/">Lees mijn verhaal <Fragment set:html={arrow} /></a></div>
      </div>
    </div>
  </section>

  <Reviews />

  <section class="prac">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="eyebrow">Praktische info</p><h2 class="split">Tarieven</h2></div>
        <p class="fade">{site.paymentMethods}. <a href="/praktische-info/">Alle praktische info →</a></p>
      </div>
      <div class="prac-grid">
        {treatments.map((t) => (
          <a class="price-card fade" href={`/${t.id}/`}>
            <h3>{t.data.title}</h3>
            <span class="p">{t.data.price}<small>/ sessie</small></span>
            <p>{t.data.durationLong}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>
