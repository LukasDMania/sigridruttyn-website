---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import site from '../data/site.json';
import reviewData from '../data/reviews.json';

const treatments = (await getCollection('pages', (p) => p.data.isTreatment)).sort(
  (a, b) => a.data.order - b.data.order,
);
const about = await getEntry('pages', 'wie-ben-ik');
const portrait = about?.data.image;
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">Behandelingen · {site.city}</p>
        <h1>{site.name}</h1>
        <p class="tagline">{site.tagline}</p>
        <div class="hero-actions">
          <a class="btn" href="/plan-je-afspraak/">Plan je afspraak</a>
          <a class="btn btn--ghost" href="/wie-ben-ik/">Wie ben ik?</a>
        </div>
      </div>
      <div class="hero-image">
        {portrait ? <img src={portrait} alt={about?.data.imageAlt ?? site.name} /> : <Placeholder />}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="center">Waarvoor kan je bij mij terecht?</h2>
      <div class="cards">
        {treatments.map((t) => (
          <a class="card" href={`/${t.id}/`}>
            <h3>{t.data.title}</h3>
            <p>{t.data.summary}</p>
            <span class="card-meta">{t.data.duration?.split(',')[0]} · {t.data.price}</span>
            <span class="card-link">Lees meer →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {reviewData.reviews.length > 0 && (
    <section class="section section--sand">
      <div class="wrap">
        <h2 class="center">Ervaringen van klanten</h2>
        <div class="reviews">
          {reviewData.reviews.map((r) => (
            <figure class="review">
              <blockquote>
                {r.title && <p class="review-title">{r.title}</p>}
                <p>{r.text}</p>
              </blockquote>
              <figcaption>— {r.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section cta">
    <div class="wrap center">
      <h2>Zin om kennis te maken?</h2>
      <p>Plan eenvoudig online een afspraak, of neem gerust contact op voor meer info.</p>
      <a class="btn" href="/plan-je-afspraak/">Plan je afspraak</a>
    </div>
  </section>
</Base>

<style>
  .center { text-align: center; }

  .hero { background: var(--zachte-salie); padding: clamp(48px, 8vw, 100px) 0; }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .hero h1 { font-size: clamp(3rem, 8vw, 5.2rem); margin-bottom: 0.2em; }
  .tagline {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.35rem, 2.8vw, 1.8rem);
    line-height: 1.35;
    color: var(--klassiek-olijf);
    max-width: 26ch;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero-image img { border-radius: var(--radius); aspect-ratio: 4 / 5; object-fit: cover; width: 100%; }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--jonge-olijf);
    border-radius: var(--radius);
    padding: 32px 28px 28px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .card:nth-child(2) { border-top-color: var(--olijfblad); }
  .card:nth-child(3) { border-top-color: var(--diep-olijf); }
  .card:hover { transform: translateY(-3px); border-color: var(--jonge-olijf); color: var(--text); }
  .card p { flex: 1; color: var(--text-muted); }
  .card-meta { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 10px; }
  .card-link {
    font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--diep-olijf); font-weight: 500;
  }

  .reviews { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 48px; }
  .review {
    margin: 0;
    background: var(--bg);
    border-radius: var(--radius);
    padding: 32px;
    display: flex;
    flex-direction: column;
  }
  .review blockquote { margin: 0; flex: 1; }
  .review blockquote p { font-family: var(--font-heading); font-size: 1.3rem; line-height: 1.5; color: var(--donker-olijf); }
  .review .review-title { font-style: italic; font-size: 1.5rem; color: var(--klassiek-olijf); }
  .review figcaption { font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }

  .cta p { max-width: 46ch; margin-left: auto; margin-right: auto; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-image { max-width: 280px; }
    .cards { grid-template-columns: 1fr; }
  }
</style>
