---
import site from '../data/site.json';
import { telHref } from '../lib/text';
---

<footer class="ftr">
  <div class="wrap">
    <p class="ftr-line">
      <b>{site.name}</b>
      <span>Adres: {site.practice} · {site.street}, {site.postalCode} {site.city}</span>
      <a href={telHref(site.phone)}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <small>© {new Date().getFullYear()} {site.name} · <a href="/privacy/">Privacyverklaring</a></small>
  </div>
</footer>
