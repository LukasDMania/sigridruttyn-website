---
// Shown where a photo will come; a quiet olive branch so the page still looks finished.
interface Props { tone?: 'sage' | 'sand' }
const { tone = 'sage' } = Astro.props;
---

<div class:list={['placeholder', `placeholder--${tone}`]} aria-hidden="true">
  <svg viewBox="0 0 200 260" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <path d="M100 250 C 98 190, 104 120, 100 20" />
    <path d="M100 210 C 80 200, 62 186, 54 166 C 76 168, 92 184, 100 210 Z" />
    <path d="M100 180 C 120 170, 138 156, 146 136 C 124 138, 108 154, 100 180 Z" />
    <path d="M100 145 C 80 135, 64 120, 58 100 C 80 104, 94 120, 100 145 Z" />
    <path d="M101 112 C 120 102, 134 88, 140 68 C 120 72, 106 88, 101 112 Z" />
    <path d="M100 78 C 84 68, 74 54, 72 36 C 90 42, 98 58, 100 78 Z" />
    <path d="M100 48 C 112 40, 120 30, 122 16 C 108 20, 102 32, 100 48 Z" />
  </svg>
</div>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    width: 100%;
  }
  .placeholder--sage { background: var(--zachte-salie); color: var(--olijfblad); }
  .placeholder--sand { background: var(--zandsteen); color: var(--klassiek-olijf); }
  .placeholder svg { width: 45%; opacity: 0.7; }
</style>
