---
import { navigation } from '../data/navigation';
import site from '../data/site.json';

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="hdr" id="hdr">
  <div class="wrap hdr-in">
    <a class="brand" href="/"><b>{site.name}</b><small>Kinesist &amp; lichaamswerker</small></a>
    <nav aria-label="Hoofdmenu">
      <ul class="nav">
        {navigation.map((item) => (
          <li>
            <a href={item.href} class:list={{ cta: item.cta }} aria-current={isActive(item.href) ? 'page' : undefined}>{item.short}</a>
          </li>
        ))}
      </ul>
    </nav>
    <button class="burger" id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="overlay"><i></i><i></i></button>
  </div>
</header>
<nav class="overlay" id="overlay" aria-label="Menu">
  {navigation.map((item) => (
    <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
  ))}
  <small>{site.practice} · {site.street}, {site.postalCode} {site.city} · {site.phone}</small>
</nav>
