---
interface Props { eyebrow?: string; title: string; lead?: string; chips?: string[] }
const { eyebrow, title, lead, chips = [] } = Astro.props;
const hasMedia = Astro.slots.has('default');
---

<section class:list={['phero', { 'has-media': hasMedia }]}>
  <div class="wrap phero-grid">
    <div>
      {eyebrow && <p class="eyebrow fade">{eyebrow}</p>}
      <h1 class="split">{title}</h1>
      {lead && <p class="lead fade">{lead}</p>}
      {chips.length > 0 && <div class="chips fade">{chips.map((c) => <span>{c}</span>)}</div>}
    </div>
    {hasMedia && <div class="phero-media"><slot /></div>}
  </div>
</section>
