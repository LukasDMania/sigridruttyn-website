---
// List of treatments.
import type { CollectionEntry } from 'astro:content';
interface Props { items: CollectionEntry<'pages'>[] }
const { items } = Astro.props;
---

<div class="rows">
  {items.map((t) => (
    <a class="row" href={`/${t.id}/`}>
      <h3>{t.data.title}</h3>
      <p>{t.data.summary}</p>
      <div class="meta">
        <span class="price">{t.data.price}</span>
        <span class="dur">{t.data.duration}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </div>
    </a>
  ))}
</div>
