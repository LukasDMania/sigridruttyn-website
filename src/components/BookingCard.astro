---
interface Props { duration?: string; price?: string }
const { duration, price } = Astro.props;
---

<aside class="booking-card">
  <p class="eyebrow">Praktisch</p>
  {duration && (
    <div class="row"><span class="label">Duur</span><span>{duration}</span></div>
  )}
  {price && (
    <div class="row"><span class="label">Prijs per sessie</span><span class="price">{price}</span></div>
  )}
  <a class="btn" href="/plan-je-afspraak/">Plan je afspraak</a>
</aside>

<style>
  .booking-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
  }
  .row {
    display: flex;
    flex-direction: column;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }
  .label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .price { font-family: var(--font-heading); font-size: 1.9rem; color: var(--donker-olijf); line-height: 1.2; }
  .btn { margin-top: 18px; width: 100%; text-align: center; }
</style>
