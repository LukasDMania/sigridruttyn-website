---
interface Props { duration?: string; durationLong?: string; price?: string }
const { duration, durationLong, price } = Astro.props;
---

<aside class="bcard">
  <p class="eyebrow">Praktisch</p>
  {duration && <div class="bc-row"><span>Duur</span><b>{duration}</b></div>}
  {price && <div class="bc-row"><span>Prijs per sessie</span><b class="bc-price">{price}</b></div>}
  {durationLong && <p class="bc-note">{durationLong}</p>}
  <a class="btn magnetic" href="/plan-je-afspraak/">Plan je afspraak <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg></a>
  <a class="bc-link" href="/praktische-info/">Praktische info →</a>
</aside>
